set nocompatible
set encoding=utf-8
filetype plugin indent on
syntax on

set backspace=indent,eol,start
set hidden
set ttimeout ttimeoutlen=100

set number
set ruler
set showcmd
set wildmenu
set laststatus=2
set scrolloff=5

set incsearch
set hlsearch
set ignorecase smartcase

set autoindent
set expandtab
set tabstop=4 shiftwidth=4 softtabstop=4
